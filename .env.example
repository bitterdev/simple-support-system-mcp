# Author: Fabian Bitter (fabian@bitter.de)
# Base URL of the Concrete CMS site that runs the Simple Support System package.
# Example: https://support.example.com
# The API path /index.php/api/v1 is appended automatically.
SIMPLE_SUPPORT_SYSTEM_BASE_URL=

# API key from the site config key simple_support_system.api_key.
# Sent as the X-Api-Key header. Without it the server only reaches the public,
# unauthenticated part of the API.
SIMPLE_SUPPORT_SYSTEM_API_KEY=

# Optional: override the API path if the site does not use the index.php dispatcher.
# Default: /index.php/api/v1
SIMPLE_SUPPORT_SYSTEM_API_PATH=

# Optional: default access token for private projects, used when a tool call
# does not pass its own token. Not needed when an API key is configured.
SIMPLE_SUPPORT_SYSTEM_PROJECT_TOKEN=

# Optional: request timeout in milliseconds. Default: 30000
SIMPLE_SUPPORT_SYSTEM_TIMEOUT_MS=
